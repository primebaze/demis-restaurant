generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── GUESTS (CRM) ───
model Guest {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  tags      String   @default("") // comma-separated: VIP,regular,birthday-april
  notes     String   @default("") // internal staff notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  visits   Visit[]
}

// ─── LOCATIONS ───
model Location {
  id       String  @id @default(cuid())
  name     String // "Cricklewood" or "Streatham Hill"
  slug     String  @unique // "cricklewood" or "streatham"
  address  String
  phone    String?
  isActive Boolean @default(true)

  timeSlots     TimeSlot[]
  bookings      Booking[]
  blackoutDates BlackoutDate[]
}

// ─── TIME SLOTS (capacity per slot per location) ───
model TimeSlot {
  id           String  @id @default(cuid())
  locationId   String
  dayOfWeek    Int? // 0=Sun, 1=Mon, ... 6=Sat (null = use specificDate)
  specificDate String? // "2026-12-25" for one-off overrides
  startTime    String // "18:00"
  endTime      String // "20:00"
  maxCovers    Int     @default(40)
  isActive     Boolean @default(true)

  location Location  @relation(fields: [locationId], references: [id])
  bookings Booking[]

  @@index([locationId, dayOfWeek])
}

// ─── BOOKING POLICIES ───
model BookingPolicy {
  id                  String @id @default(cuid())
  locationSlug        String @unique // "cricklewood", "streatham", or "default"
  minPartySize        Int    @default(1)
  maxPartySize        Int    @default(30)
  depositThreshold    Int    @default(15) // party size that triggers deposit
  depositAmountPence  Int    @default(2000) // £20.00
  cancellationWindowH Int    @default(24) // hours before booking
  maxAdvanceDays      Int    @default(30) // how far ahead guests can book
  autoCancelMinutes   Int    @default(15) // no-show auto-cancel
}

// ─── BOOKINGS ───
model Booking {
  id                    String    @id @default(cuid())
  confirmationCode      String    @unique // e.g. "DEM-4K7X"
  guestId               String
  locationId            String
  timeSlotId            String
  date                  String // "2026-04-20"
  time                  String // "19:00"
  partySize             Int
  status                String    @default("confirmed") // pending_payment, confirmed, modified, cancelled_guest, cancelled_admin, no_show, completed
  source                String    @default("website") // website, phone, walk-in, admin
  notes                 String    @default("")
  depositAmountPence    Int       @default(0)
  depositStatus         String    @default("none") // none, pending, captured, refunded
  stripePaymentIntentId String?
  managementToken       String    @unique // for guest magic link access
  reminderSent          Boolean   @default(false)
  acceptedTermsAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  guest    Guest          @relation(fields: [guestId], references: [id])
  location Location       @relation(fields: [locationId], references: [id])
  timeSlot TimeSlot       @relation(fields: [timeSlotId], references: [id])
  changes  BookingChange[]
  addOns   BookingAddOn[]

  @@index([date, locationId])
  @@index([guestId])
  @@index([status])
}

// ─── BOOKING CHANGES (audit log) ───
model BookingChange {
  id           String   @id @default(cuid())
  bookingId    String
  changedBy    String // email or "admin" or "system"
  fieldChanged String
  oldValue     String
  newValue     String
  createdAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

// ─── ADD-ONS ───
model AddOn {
  id          String  @id @default(cuid())
  name        String // "Birthday Cake Setup"
  description String  @default("")
  pricePence  Int // 1500 = £15.00
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  bookings BookingAddOn[]
}

model BookingAddOn {
  id        String @id @default(cuid())
  bookingId String
  addOnId   String
  quantity  Int    @default(1)

  booking Booking @relation(fields: [bookingId], references: [id])
  addOn   AddOn   @relation(fields: [addOnId], references: [id])

  @@unique([bookingId, addOnId])
}

// ─── BLACKOUT DATES ───
model BlackoutDate {
  id         String    @id @default(cuid())
  locationId String?
  date       String // "2026-12-25"
  reason     String // "Christmas Day", "Private Hire"

  location Location? @relation(fields: [locationId], references: [id])

  @@index([date])
}

// ─── VISITS (CRM) ───
model Visit {
  id         String   @id @default(cuid())
  guestId    String
  bookingId  String?
  spendPence Int      @default(0)
  visitDate  String
  notes      String   @default("")
  createdAt  DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id])

  @@index([guestId])
}

// ─── ADMIN USERS ───
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // staff, manager, owner
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─── BLOG AUTHORS (separate from admin) ───
model BlogAuthor {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  bio          String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  posts BlogPost[]
}

// ─── BLOG CATEGORIES ───
model BlogCategory {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String @default("")
  sortOrder   Int    @default(0)

  posts BlogPost[]
}

// ─── BLOG POSTS ───
model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @default("")
  content         String    @default("")
  featuredImage   String?
  categoryId      String?
  authorId        String
  status          String    @default("draft") // draft, published
  publishedAt     DateTime?
  views           Int       @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author   BlogAuthor    @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])
  comments BlogComment[]

  @@index([status, publishedAt])
}

// ─── SET MENU GROUPS ───
model SetMenuGroup {
  id             String   @id @default(cuid())
  groupCode      String   @unique // e.g. "SM-0001"
  organizerName  String
  organizerEmail String   @default("")
  organizerPhone String   @default("")
  date           String   // "2026-05-15"
  partySize      Int
  locationSlug   String   @default("cricklewood")
  notes          String   @default("")
  status         String   @default("active") // active, completed, cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  selections SetMenuSelection[]

  @@index([date])
  @@index([status])
}

// ─── SET MENU GUEST SELECTIONS ───
model SetMenuSelection {
  id         String   @id @default(cuid())
  groupId    String
  guestName  String
  appetiser  String   // "Puff Puff" | "Samosa" | "Spring Rolls"
  starter    String   @default("Salad")
  main       String   @default("Jollof Rice")
  protein    String   @default("Chicken")
  dessert    String   @default("Ice Cream Xplosion")
  allergies  String   @default("")
  createdAt  DateTime @default(now())

  group SetMenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// ─── EMAIL LOG / QUEUE ───
model EmailLog {
  id        String    @id @default(cuid())
  recipient String
  subject   String
  type      String    @default("transactional") // transactional, direct, bulk, admin
  provider  String    @default("smtp") // smtp, resend
  status    String    @default("sent") // sent, failed, queued
  error     String    @default("")
  bodyHtml  String    @default("") // retained for bulk so a send can be retried
  campaign  String    @default("") // label grouping a bulk batch
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status])
  @@index([createdAt])
}

// ─── APP SETTINGS (small key/value store) ───
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── BUFFET CHECK-INS (door kiosk) ───
model BuffetCheckIn {
  id          String   @id @default(cuid())
  date        String // service date "2026-06-21"
  number      Int // sequential per date, starts at 1
  name        String   @default("")
  partySize   Int      @default(1)
  priceTier   Int      @default(20) // 20, 25 or 30
  checkedInAt DateTime @default(now())
  endsAt      DateTime // checkedInAt + 90 min
  status      String   @default("active") // active, finished
  createdAt   DateTime @default(now())

  @@unique([date, number])
  @@index([date])
}

// ─── BUFFET BOOKINGS (staff-entered) ───
model BuffetBooking {
  id           String   @id @default(cuid())
  bookingCode  String   @unique // e.g. "BF-A3KX9P2M"
  name         String
  email        String   @default("")
  phone        String   @default("")
  partySize    Int
  date         String   // "2026-05-15"
  time         String   // "19:00"
  locationSlug String   @default("cricklewood")
  notes        String   @default("")
  status       String   @default("confirmed") // confirmed, cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([status])
}

// ─── BLOG ADS ───
model BlogAd {
  id        String   @id @default(cuid())
  title     String   @default("")
  imageUrl  String
  linkUrl   String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// ─── MAILING LIST (marketing / email blast) ───
// Separate from Guest so uploaded lists never affect bookings or the website.
model MailingContact {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  source       String   @default("manual") // csv, pdf, manual
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([unsubscribed])
}

// ─── BLOG COMMENTS ───
model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  name      String
  email     String
  content   String
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
}
